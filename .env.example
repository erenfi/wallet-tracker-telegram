# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456:REPLACE_ME

# Optional Discord delivery. Use a Discord channel webhook URL.
DISCORD_WEBHOOK_URL=
DISCORD_MIN_SEND_INTERVAL_MS=1200
DISCORD_MAX_QUEUE_SIZE=250

# Optional: comma-separated Telegram chat IDs allowed to control the bot.
# Leave blank to allow the first chat that messages /start.
AUTHORIZED_CHAT_IDS=

# Polling controls.
CHAIN_POLL_MS=12000
TELEGRAM_POLL_TIMEOUT=50
MAX_BLOCKS_PER_POLL=25
CONFIRMATIONS=1

# Hide native ETH dust transfers. Token/NFT marketplace alerts are unaffected.
# Example: 0.001 suppresses tiny inbound ETH transfers such as 0.000041 ETH.
MIN_NATIVE_INCOMING_ALERT=0.001
MIN_NATIVE_OUTGOING_ALERT=0

# Suppress obvious scam/spam assets such as unsolicited inbound NFTs.
HIDE_SUSPICIOUS_INBOUND=true
LABEL_RISKY_ASSETS=true

# EVM chain RPCs. Add/remove chains in chains.json.
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
BASE_RPC_URL=https://mainnet.base.org
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
